; Without architected SGPRs, llvm.amdgcn.wave.id is computed as
; readfirstlane(workitem.id.x >> log2(wavesize)). This needs a one-dimensional
; workgroup, stated by reqd_work_group_size.

define amdgpu_kernel void @wave_id_256(ptr addrspace(1) %out) #0 !reqd_work_group_size !0 {
; GFX950-LABEL: wave_id_256:
; GFX950:       ; %bb.0:
; GFX950-NEXT:    s_load_dwordx2 s[0:1], s[4:5], 0x0
; GFX950-NEXT:    v_lshrrev_b32_e32 v0, 6, v0
; GFX950-NEXT:    v_mov_b32_e32 v1, 0
; GFX950-NEXT:    v_readfirstlane_b32 s2, v0
; GFX950-NEXT:    s_nop 1
; GFX950-NEXT:    v_mov_b32_e32 v0, s2
; GFX950-NEXT:    s_waitcnt lgkmcnt(0)
; GFX950-NEXT:    global_store_dword v1, v0, s[0:1]
; GFX950-NEXT:    s_endpgm
  %id = call i32 @llvm.amdgcn.wave.id()
  store i32 %id, ptr addrspace(1) %out
  ret void
}

; A single wave: the wave ID is 0.
define amdgpu_kernel void @wave_id_64(ptr addrspace(1) %out) #1 !reqd_work_group_size !1 {
; GFX950-LABEL: wave_id_64:
; GFX950:       ; %bb.0:
; GFX950-NEXT:    s_load_dwordx2 s[0:1], s[4:5], 0x0
; GFX950-NEXT:    v_mov_b32_e32 v0, 0
; GFX950-NEXT:    s_waitcnt lgkmcnt(0)
; GFX950-NEXT:    global_store_dword v0, v0, s[0:1]
; GFX950-NEXT:    s_endpgm
  %id = call i32 @llvm.amdgcn.wave.id()
  store i32 %id, ptr addrspace(1) %out
  ret void
}

; The result is uniform: it can feed scalar arithmetic.
define amdgpu_kernel void @wave_id_uniform(ptr addrspace(1) %out) #0 !reqd_work_group_size !0 {
; SDAG-LABEL: wave_id_uniform:
; SDAG:       ; %bb.0:
; SDAG-NEXT:    s_load_dwordx2 s[0:1], s[4:5], 0x0
; SDAG-NEXT:    v_lshrrev_b32_e32 v0, 6, v0
; SDAG-NEXT:    s_nop 0
; SDAG-NEXT:    v_readfirstlane_b32 s2, v0
; SDAG-NEXT:    s_lshl_b32 s3, s2, 12
; SDAG-NEXT:    v_mov_b32_e32 v0, s3
; SDAG-NEXT:    v_mov_b32_e32 v1, s2
; SDAG-NEXT:    s_waitcnt lgkmcnt(0)
; SDAG-NEXT:    global_store_dword v0, v1, s[0:1]
; SDAG-NEXT:    s_endpgm
;
; GISEL-LABEL: wave_id_uniform:
; GISEL:       ; %bb.0:
; GISEL-NEXT:    s_load_dwordx2 s[0:1], s[4:5], 0x0
; GISEL-NEXT:    v_lshrrev_b32_e32 v0, 6, v0
; GISEL-NEXT:    s_nop 0
; GISEL-NEXT:    v_readfirstlane_b32 s2, v0
; GISEL-NEXT:    s_lshl_b32 s3, s2, 12
; GISEL-NEXT:    v_mov_b32_e32 v1, s3
; GISEL-NEXT:    v_mov_b32_e32 v0, s2
; GISEL-NEXT:    s_waitcnt lgkmcnt(0)
; GISEL-NEXT:    global_store_dword v1, v0, s[0:1]
; GISEL-NEXT:    s_endpgm
  %id = call i32 @llvm.amdgcn.wave.id()
  %mul = mul i32 %id, 1024
  %gep = getelementptr i32, ptr addrspace(1) %out, i32 %mul
  store i32 %id, ptr addrspace(1) %gep
  ret void
}

attributes #0 = { "amdgpu-flat-work-group-size"="256,256" }
attributes #1 = { "amdgpu-flat-work-group-size"="64,64" }

!0 = !{i32 256, i32 1, i32 1}
